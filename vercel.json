{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bostonoldpath.vercel.app"
        }
      ],
      "destination": "https://bostonmindfulness.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mcgb-feedback-2.vercel.app"
        }
      ],
      "destination": "https://bostonmindfulness.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bostonoldpath-mindfullybuildings-projects.vercel.app"
        }
      ],
      "destination": "https://bostonmindfulness.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bostonoldpath-git-main-mindfullybuildings-projects.vercel.app"
        }
      ],
      "destination": "https://bostonmindfulness.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bostonoldpath-mindfullybuilding-mindfullybuildings-projects.vercel.app"
        }
      ],
      "destination": "https://bostonmindfulness.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/our-community-feedback-2.html",
      "destination": "/our-community.html",
      "permanent": true
    },
    {
      "source": "/resources-feedback-2.html",
      "destination": "/resources.html",
      "permanent": true
    },
    {
      "source": "/our-practice-feedback-1.html",
      "destination": "/our-practice.html",
      "permanent": true
    },
    {
      "source": "/find-a-sangha-feedback-2.html",
      "destination": "/find-a-sangha.html",
      "permanent": true
    },
    {
      "source": "/find-a-sangha-feedback-3.html",
      "destination": "/find-a-sangha.html",
      "permanent": true
    },
    {
      "source": "/resources-feedback-3.html",
      "destination": "/resources.html",
      "permanent": true
    },
    {
      "source": "/our-community-feedback-3.html",
      "destination": "/our-community.html",
      "permanent": true
    },
    {
      "source": "/mcgb-homepage-wireframe-feedback-3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bops-homepage-wireframe-feedback-1.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/newsletters-feedback-2.html",
      "destination": "/newsletters.html",
      "permanent": true
    },
    {
      "source": "/bops-homepage-wireframe-6.15.26.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mcgb-homepage-wireframe-feedback-2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/join-mailing-list-feedback-2.html",
      "destination": "/join-mailing-list.html",
      "permanent": true
    },
    {
      "source": "/join-mailing-list-feedback-1.html",
      "destination": "/join-mailing-list.html",
      "permanent": true
    },
    {
      "source": "/newsletters-feedback-1.html",
      "destination": "/newsletters.html",
      "permanent": true
    },
    {
      "source": "/bops-homepage-wireframe.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/find-a-sangha-feedback-1.html",
      "destination": "/find-a-sangha.html",
      "permanent": true
    },
    {
      "source": "/our-community-feedback-1.html",
      "destination": "/our-community.html",
      "permanent": true
    },
    {
      "source": "/resources-feedback-1.html",
      "destination": "/resources.html",
      "permanent": true
    },
    {
      "source": "/our-practice-feedback-2.html",
      "destination": "/our-practice.html",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
